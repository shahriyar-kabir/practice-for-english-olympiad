{
  "name": "wordsprout",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:guardian-db": "node scripts/test-guardian-db.mjs",
    "test:guardian-concurrency": "node scripts/test-guardian-concurrency.mjs",
    "test:accounts": "node scripts/test-account-release.mjs",
    "test:public-support": "node scripts/test-public-support.mjs",
    "dev:ios": "vite --config vite.ios.config.ts --host 0.0.0.0",
    "build:ios": "tsc -b && vite build --config vite.ios.config.ts && node scripts/ios/finalize-bundle.mjs",
    "ios:sync": "npm run build:ios && cap sync ios",
    "ios:open": "cap open ios",
    "ios:check": "node scripts/ios/check-project.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/network": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource/fraunces": "^5.2.7",
    "@fontsource/nunito": "^5.2.7",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@electric-sql/pglite": "^0.5.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
