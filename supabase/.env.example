# Server-side Edge Function secrets ONLY. Copy to an ignored .env file and use
# `supabase secrets set --env-file <file> --project-ref <confirmed-ref>`.
# Never put these credentials in VITE_ variables or commit a populated file.
RESEND_API_KEY=replace-with-resend-sending-key
GUARDIAN_FROM_EMAIL=Wizpiko <guardian@your-verified-domain.example>
# Updated frontend deployment serving the guardian review route, with no trailing slash.
APP_ORIGIN=https://your-updated-frontend.example
# Optional comma-separated exact HTTPS origins; no wildcard or Netlify suffix matching.
GUARDIAN_ALLOWED_ORIGINS=https://your-explicit-preview.netlify.app
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by hosted Supabase.
