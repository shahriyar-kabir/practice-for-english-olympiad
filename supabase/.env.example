# Server-side Edge Function secrets ONLY. Copy to an ignored .env file and use
# `supabase secrets set --env-file <file> --project-ref <confirmed-ref>`.
# Never put these credentials in VITE_ variables or commit a populated file.
APP_ORIGIN=https://wizpiko.com
# Optional comma-separated exact HTTPS preview origins; no wildcards or paths.
PUBLIC_SUPPORT_ALLOWED_ORIGINS=
PUBLIC_SUPPORT_RATE_LIMIT_SALT=replace-with-a-private-random-salt-at-least-32-characters

# Recommended: use the existing SpaceMail mailbox. Nothing sends until this
# configuration is securely applied and the approved function is deployed.
# Explicit choice: smtp or resend. A failure never falls back to another service.
PUBLIC_SUPPORT_MAIL_TRANSPORT=smtp
PUBLIC_SUPPORT_FROM_EMAIL=Wizpiko <support@wizpiko.com>
PUBLIC_SUPPORT_SMTP_HOST=mail.spacemail.com
PUBLIC_SUPPORT_SMTP_PORT=465
PUBLIC_SUPPORT_SMTP_USERNAME=support@wizpiko.com
PUBLIC_SUPPORT_SMTP_PASSWORD=replace-with-mailbox-password-in-ignored-secret-file-only

# Optional alternative only: choose PUBLIC_SUPPORT_MAIL_TRANSPORT=resend and
# configure a verified sender plus this key. SpaceMail SMTP does not need Resend.
RESEND_API_KEY=

# Historical retired guardian function only; not deployed by this release.
GUARDIAN_FROM_EMAIL=Wizpiko <guardian@your-verified-domain.example>
GUARDIAN_ALLOWED_ORIGINS=https://your-explicit-preview.netlify.app
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by hosted Supabase.
